# Base de datos (PostgreSQL 18.6)
POSTGRES_USER=aprende
POSTGRES_PASSWORD=aprende
POSTGRES_DB=aprende_gratis
DATABASE_URL=postgresql+psycopg://aprende:aprende@postgres:5432/aprende_gratis

# Puertos locales para desarrollo
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Autenticación y seguridad (JWT)
JWT_SECRET=supersecreto-desarrollo-cambiar-en-produccion
JWT_EXPIRA_MINUTOS=60

# Servidor de correos en desarrollo (Mailpit)
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_REMITENTE=no-responder@aprende-gratis.local
FRONTEND_URL=http://localhost:5173
